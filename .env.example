# Database Configuration (PostgreSQL instance, e.g., Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_media_platform?schema=public"

# Cloudinary Configuration (from Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME="demo"
