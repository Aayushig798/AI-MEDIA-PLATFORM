# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

NEXTAUTH_URL="https://your-domain"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Only for `npm run dev` outside Docker; `docker compose up` uses its bundled Postgres.
# Needs the pgvector extension, e.g. docker run -p 5433:5432 -e POSTGRES_PASSWORD=dev pgvector/pgvector:pg18
DATABASE_URL="your-postgresql-url"
# Password for the Docker Compose database (letters and digits; scripts/ops/deploy.sh generates one)
POSTGRES_PASSWORD=""

# ---------------------------------------------------------------------------
# AI and integrity checks (optional: a check is skipped, not failed, when unset)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""                              # aistudio.google.com/apikey: AI auditor, tagging fallback, pair verification, embeddings, narratives
GEMINI_MODEL="gemini-3.5-flash-lite"           # text + vision; verify with `npm run ai:check`
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"  # 1536-dimension embeddings (matches the pgvector column)
GOOGLE_VISION_API_KEY=""                       # web detection ("found online"); needs billing enabled
COPERNICUS_CLIENT_ID=""                        # Sentinel-2 satellite check (dataspace.copernicus.eu OAuth client)
COPERNICUS_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Deployment and extras (optional)
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=""                    # public URL so Cloudinary webhooks arrive and QR codes open on phones
NEXT_PUBLIC_BASE_URL=""
ANCHOR_TOKEN=""                       # shared secret for the daily ledger-anchor workflow
CLOUDINARY_C2PA_ENABLED="false"       # true once Cloudinary grants Content Credentials (beta)
CLOUDINARY_AUTO_TRANSCRIPTION="false" # true: transcribe field-video voice notes for reel subtitles
