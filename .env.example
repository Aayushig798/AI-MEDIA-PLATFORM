# Database (PostgreSQL 14+). Local dev container used by this repo:
#   docker run -d --name ecoevidence-postgres -e POSTGRES_USER=ecoevidence -e POSTGRES_PASSWORD=ecoevidence_dev \
#     -e POSTGRES_DB=ai_media_platform -p 5433:5432 -v ecoevidence_pgdata:/var/lib/postgresql/data postgres:16-alpine
DATABASE_URL="postgresql://ecoevidence:ecoevidence_dev@localhost:5433/ai_media_platform?schema=public"

# Cloudinary (Dashboard -> API Keys). Enable the free "Cloudinary AI Vision" add-on
# for the AI auditor (claim match) and provenance checks.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Content Credentials signing (fl_c2pa) is a request-only beta; set to true once granted.
CLOUDINARY_C2PA_ENABLED="false"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-string-of-32-plus-characters"

# Public URL of the deployed app (or an ngrok/cloudflared tunnel). Needed so
# Cloudinary webhooks can reach /api/cloudinary/webhook and so QR codes on
# reels/reports open on a phone. Leave empty for plain localhost.
PUBLIC_BASE_URL=""
NEXT_PUBLIC_BASE_URL=""

# Optional integrity checks (each is skipped, not failed, when unset)
GOOGLE_VISION_API_KEY=""        # "found on the internet" (Web Detection, 1,000 free/month)
COPERNICUS_CLIENT_ID=""         # Sentinel-2 satellite check (dataspace.copernicus.eu OAuth client)
COPERNICUS_CLIENT_SECRET=""

# Optional: LLM wording for impact reports (drafts adding any number not in the facts are rejected)
OPENAI_API_KEY=""
OPENAI_REPORT_MODEL="gpt-4o-mini"
