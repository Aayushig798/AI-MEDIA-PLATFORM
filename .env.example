DATABASE_URL="your-postgresql-url"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

NEXTAUTH_URL="https://your-domain"
NEXTAUTH_SECRET="generate-a-long-random-secret"
# --- Proof-of-Impact Integrity Engine (all optional; checks are skipped, not failed, when unset) ---
# Needs PostgreSQL with pgvector, e.g. locally:
#   docker run -d --name ecoevidence-postgres -e POSTGRES_USER=ecoevidence -e POSTGRES_PASSWORD=ecoevidence_dev \
#     -e POSTGRES_DB=ai_media_platform -p 5433:5432 pgvector/pgvector:pg16
# Enable the free "Cloudinary AI Vision" add-on for the AI auditor and provenance checks.
GEMINI_API_KEY=""               # aistudio.google.com/apikey: pair verification, captions, report narrative, semantic-search embeddings
GEMINI_MODEL="gemini-3.5-flash-lite"           # text + vision (Google renames models often; check with `npm run ai:check`)
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"  # 1536-dimension embeddings (matches the pgvector column)
GOOGLE_VISION_API_KEY=""        # AI tagging fallback + "found on the internet" (Web Detection)
COPERNICUS_CLIENT_ID=""         # Sentinel-2 satellite check (dataspace.copernicus.eu OAuth client)
COPERNICUS_CLIENT_SECRET=""
CLOUDINARY_C2PA_ENABLED="false" # set true once Cloudinary grants Content Credentials (beta)
# Public URL (deploy or tunnel) so Cloudinary webhooks arrive and QR codes open on phones
PUBLIC_BASE_URL=""
NEXT_PUBLIC_BASE_URL=""
CLOUDINARY_AUTO_TRANSCRIPTION="false" # true: transcribe field-video voice notes for reel subtitles
ANCHOR_TOKEN=""                 # shared secret for the daily ledger-anchor GitHub Action
