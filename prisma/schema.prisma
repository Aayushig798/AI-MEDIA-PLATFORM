// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // Loads `include`d relations in one SQL query (LATERAL joins) instead of one query per relation
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  projects  Project[]
}

model Project {
  id          String       @id @default(cuid())
  name        String
  description String?
  location    String?
  startDate   DateTime?
  createdBy   String
  user        User         @relation(fields: [createdBy], references: [id])
  createdAt   DateTime     @default(now())
  assets      MediaAsset[]
  comparisons Comparison[]
  reports     Report[]
  reels       Reel[]
  // Integrity Engine inputs (site, geofence, what the evidence should show)
  latitude        Float?
  longitude       Float?
  geofenceRadiusM Int        @default(5000)
  impactType      ImpactType @default(OTHER)
  claim           String?
}

// What kind of change the project claims; picks the satellite index and the
// direction of change we expect to see.
enum ImpactType {
  GREENING
  WATER
  INFRASTRUCTURE
  COMMUNITY
  OTHER
}

model MediaAsset {
  id                  String               @id @default(cuid())
  projectId           String
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cloudinaryPublicId  String               @unique
  secureUrl           String
  resourceType        String               // "image" | "video"
  format              String
  bytes               Int
  width               Int?
  height              Int?
  manualCategory      String?
  categorySource      String               @default("ai") // "ai" | "user"
  manualLocation       String?
  manualNotes         String?
  capturedAt          DateTime?
  uploadedBy          String
  exifLat             Float?
  exifLng             Float?
  aiProcessingStatus  String               @default("pending") // "pending" | "processing" | "done" | "failed"
  aiTags              AiTag[]
  categories          MediaAssetCategory[]
  embedding           MediaEmbedding?
  auditLogs           AssetAuditLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  // Integrity Engine fingerprints and results
  etag                String?
  sha256              String?
  phash               String?              // 16 hex chars from Cloudinary
  claimText           String?              // per-asset claim, overrides Project.claim
  integrity           AssetIntegrity?
  phashMatches        PhashMatch[]         @relation("PhashSource")
  webMatches          WebMatch[]
  derived             DerivedAsset[]
}

model AiTag {
  id           String     @id @default(cuid())
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  label        String
  confidence   Float
  source       String     // "cloudinary_google" | "cloudinary_rekognition" | "external_vision"
  createdAt    DateTime   @default(now())
}

model Category {
  id     String               @id @default(cuid())
  name   String               @unique
  assets MediaAssetCategory[]
}

model MediaAssetCategory {
  id           String     @id @default(cuid())
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, categoryId])
}

model MediaEmbedding {
  id           String     @id @default(cuid())
  mediaAssetId String     @unique
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  embedding    Unsupported("vector(1536)")
  modelVersion String
  createdAt    DateTime   @default(now())
}

model Comparison {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  beforeAssetId   String
  afterAssetId    String
  notes           String?
  verified        Boolean  @default(false)
  matchConfidence Float?
  aiReason        String?
  changeSummary   String?
  createdBy       String
  createdAt       DateTime @default(now())
  metrics         ChangeMetric[]
}

model PairVerification {
  id            String   @id @default(cuid())
  beforeAssetId String
  afterAssetId  String
  sameScene     Boolean
  confidence    Float
  reason        String
  visibleChange String
  createdAt     DateTime @default(now())

  @@unique([beforeAssetId, afterAssetId])
  @@index([beforeAssetId])
  @@index([afterAssetId])
}

model Report {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String?
  generatedSummary String   @db.Text
  selectedAssetIds String[]
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AssetAuditLog {
  id           String     @id @default(cuid())
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  eventType    String     // "uploaded" | "ai_tagged" | "embedded" | "used_in_comparison" | "used_in_report"
  eventDetail  Json
  actor        String
  createdAt    DateTime   @default(now())

  @@index([mediaAssetId])
  @@index([eventType])
}

// ---------------------------------------------------------------------------
// Proof-of-Impact Integrity Engine
// ---------------------------------------------------------------------------

enum IntegrityStatus {
  PENDING
  RUNNING
  DONE
  ERROR
}

enum Verdict {
  VERIFIED
  REVIEW
  FLAGGED
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

model AssetIntegrity {
  id             String          @id @default(cuid())
  assetId        String          @unique
  asset          MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  status         IntegrityStatus @default(PENDING)
  trustScore     Int?
  verdict        Verdict?
  checks         Json            @default("[]") // CheckResult[]
  exif           Json?
  gpsLat         Float?
  gpsLng         Float?
  takenAt        DateTime?
  error          String?
  reviewDecision ReviewDecision?
  reviewNote     String?
  reviewedBy     String?
  reviewedAt     DateTime?
  computedAt     DateTime?
  updatedAt      DateTime        @updatedAt
}

model PhashMatch {
  id           String     @id @default(cuid())
  assetId      String
  asset        MediaAsset @relation("PhashSource", fields: [assetId], references: [id], onDelete: Cascade)
  matchAssetId String
  hamming      Int
  crossProject Boolean
  createdAt    DateTime   @default(now())

  @@unique([assetId, matchAssetId])
}

enum WebMatchKind {
  FULL
  PARTIAL
  PAGE
}

model WebMatch {
  id        String       @id @default(cuid())
  assetId   String
  asset     MediaAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  url       String
  kind      WebMatchKind
  score     Float?
  pageTitle String?
  createdAt DateTime     @default(now())
}

// Cloudinary's Content Credentials vocabulary: "transcoded" derivatives keep
// evidentiary value, "edited" ones are illustrative only.
enum DerivationClass {
  TRANSCODED
  EDITED
}

model DerivedAsset {
  id             String          @id @default(cuid())
  assetId        String
  asset          MediaAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  transformation String
  url            String          @unique
  class          DerivationClass
  purpose        String
  createdAt      DateTime        @default(now())
}

// Append-only, hash-chained ledger. assetId/projectId are plain strings (no FK)
// so entries survive deletion of what they describe. AssetAuditLog events are
// mirrored here so the traceability timeline is tamper-evident.
model LedgerEntry {
  id        String   @id @default(cuid())
  seq       Int      @unique
  type      String
  assetId   String?
  projectId String?
  actor     String
  payload   Json
  prevHash  String
  entryHash String
  createdAt DateTime

  @@index([assetId])
  @@index([projectId])
}

model MerkleAnchor {
  id          String   @id @default(cuid())
  fromSeq     Int
  toSeq       Int
  entryCount  Int
  root        String
  externalRef String?
  createdAt   DateTime @default(now())
}

enum MetricKind {
  GREEN_COVER
  WATER_AREA
}

model ChangeMetric {
  id           String     @id @default(cuid())
  comparisonId String
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  metric       MetricKind
  beforePct    Float
  afterPct     Float
  deltaPp      Float
  method       String
  maskPublicId String?
  maskUrl      String?
  alignment    Json?
  satDelta     Json?
  createdAt    DateTime   @default(now())
}

model Reel {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comparisonId   String?
  aspect         String // "9:16" | "1:1"
  deliveryUrl    String
  sourceAssetIds String[]
  createdAt      DateTime @default(now())
}
