// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  projects  Project[]
}

model Project {
  id          String       @id @default(cuid())
  name        String
  description String?
  location    String?
  startDate   DateTime?
  createdBy   String
  user        User         @relation(fields: [createdBy], references: [id])
  createdAt   DateTime     @default(now())
  assets      MediaAsset[]
  comparisons Comparison[]
}

model MediaAsset {
  id                  String               @id @default(cuid())
  projectId           String
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cloudinaryPublicId  String               @unique
  secureUrl           String
  resourceType        String               // "image" | "video"
  format              String
  bytes               Int
  width               Int?
  height              Int?
  manualCategory      String?
  categorySource      String               @default("ai") // "ai" | "user"
  manualLocation       String?
  manualNotes         String?
  capturedAt          DateTime?
  uploadedBy          String
  exifLat             Float?
  exifLng             Float?
  aiProcessingStatus  String               @default("pending") // "pending" | "processing" | "done" | "failed"
  aiTags              AiTag[]
  categories          MediaAssetCategory[]
  embedding           MediaEmbedding?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model AiTag {
  id           String     @id @default(cuid())
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  label        String
  confidence   Float
  source       String     // "cloudinary_google" | "cloudinary_rekognition" | "external_vision"
  createdAt    DateTime   @default(now())
}

model Category {
  id     String               @id @default(cuid())
  name   String               @unique
  assets MediaAssetCategory[]
}

model MediaAssetCategory {
  id           String     @id @default(cuid())
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, categoryId])
}

model MediaEmbedding {
  id           String     @id @default(cuid())
  mediaAssetId String     @unique
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  embedding    Unsupported("vector(1536)")
  modelVersion String
  createdAt    DateTime   @default(now())
}

model Comparison {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  beforeAssetId   String
  afterAssetId    String
  notes           String?
  verified        Boolean  @default(false)
  matchConfidence Float?
  aiReason        String?
  changeSummary   String?
  createdBy       String
  createdAt       DateTime @default(now())
}

model PairVerification {
  id            String   @id @default(cuid())
  beforeAssetId String
  afterAssetId  String
  sameScene     Boolean
  confidence    Float
  reason        String
  visibleChange String
  createdAt     DateTime @default(now())

  @@unique([beforeAssetId, afterAssetId])
  @@index([beforeAssetId])
  @@index([afterAssetId])
}


