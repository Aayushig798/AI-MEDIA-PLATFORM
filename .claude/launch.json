{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ecoevidence-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "ecoevidence-dev-isolated",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set NEXT_DIST_DIR=.next-preview&& npm run dev"],
      "port": 3100,
      "autoPort": true
    }
  ]
}
